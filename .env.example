# PostgreSQL settings used by Docker Compose and the backend.
POSTGRES_DB=campuspulse
POSTGRES_USER=campuspulse
POSTGRES_PASSWORD=campuspulse_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
CAMPUS_TIMEZONE=Asia/Kolkata

# The hostname is `db` when the backend runs inside Docker Compose.
DATABASE_URL=postgresql+psycopg://campuspulse:campuspulse_dev_password@db:5432/campuspulse

# Local model runtime used by the Phase 10 backend agent.
# `host.docker.internal` lets the Docker backend reach Ollama running on macOS.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=120
